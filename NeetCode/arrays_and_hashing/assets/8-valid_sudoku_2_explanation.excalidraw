      "locked": false,
      "text": "rows = [0, 0, 0, 0, 0, 0, 0, 0, 0]\n\nval = int(board[r][c]) - 1   # val = int(\"5\") - 1 = 4\nmask = 1 << val               # mask = 1 << 4 = 16\nif (mask) & rows[r]:\n  return False\n\nrows[r] |= mask",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rows = [0, 0, 0, 0, 0, 0, 0, 0, 0]\n\nval = int(board[r][c]) - 1   # val = int(\"5\") - 1 = 4\nmask = 1 << val               # mask = 1 << 4 = 16\nif (mask) & rows[r]:\n  return False\n\nrows[r] |= mask",
      "autoResize": true,
      "lineHeight": 1.25
